{
  "name": "harnesssec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harness-native flight recorder and policy for AI agent harnesses",
  "bin": {
    "harnesssec": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./adapters/deepseek": "./dist/adapters/deepseek/index.js",
    "./adapters/openhands": "./dist/adapters/openhands/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "node --import tsx src/cli/main.ts demo",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:integration:openhands": "node --import tsx --test tests/integration/openhands-live.test.ts",
    "test:all": "npm run test && npm run test:integration",
    "cli": "node --import tsx src/cli/main.ts",
    "experiment:live-autonomy": "node --import tsx scripts/live-autonomy/runner.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell-env": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-bash": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
