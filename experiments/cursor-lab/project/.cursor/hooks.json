{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }],
    "sessionEnd": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }],
    "beforeSubmitPrompt": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }],
    "beforeShellExecution": [{ "command": "bash .cursor/hooks/harnx-cursor.sh", "failClosed": true }],
    "afterShellExecution": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }],
    "beforeReadFile": [{ "command": "bash .cursor/hooks/harnx-cursor.sh", "failClosed": true }],
    "beforeMCPExecution": [{ "command": "bash .cursor/hooks/harnx-cursor.sh", "failClosed": true }],
    "preToolUse": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }],
    "postToolUse": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }],
    "subagentStart": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }],
    "subagentStop": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }],
    "stop": [{ "command": "bash .cursor/hooks/harnx-cursor.sh" }]
  }
}
